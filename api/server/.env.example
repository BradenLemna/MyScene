# MyScene API server configuration.
# Copy this file to `.env` (same directory) and fill in real values.
# Real process environment variables always take precedence over .env.

# Port the API server listens on
PORT=3000

# Base URL of the PHP db-api endpoints (no trailing slash).
# In production these are served by Apache/PHP on the API host.
DB_API_BASE_URL=http://apiserver.lan

# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=https://myscene.live,http://127.0.0.1:5500

# Upstream API keys (never commit real keys).
# LOCATIONIQ_API_KEY is required for /autocomplete, /getLatitude, /getLongitude, /getLocation.
LOCATIONIQ_API_KEY=
# LASTFM_API_KEY is required for /getGenre.
LASTFM_API_KEY=

# Optional: override the upstream base URLs (no trailing slash). Only needed
# for staging/testing against mock services — the defaults below are the
# production endpoints.
# LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
# LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0

# Timeout for upstream HTTP calls, in milliseconds.
UPSTREAM_TIMEOUT_MS=10000
